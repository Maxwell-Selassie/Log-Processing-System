                <mxCell id="13" value="LOGGING AND OBSERVABILITY: RUN ID | SUCCESSFUL RUNS AND ERRORS LOGGED | AGGREGATION RESULTS LOGGED | ALL PIPELINE RESULTS LOGGED" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="-100" y="700" width="920" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;LOGS&lt;/h1&gt;&lt;div&gt;WE WRITE AN INGEST.PY FILE TO INGEST ALL THE LOGS FROM THE SERVER. WE CATER FOR:&lt;/div&gt;&lt;div&gt;RETRIES&lt;/div&gt;&lt;div&gt;NETWORK CONNECTIVITY ISSUES&lt;/div&gt;&lt;div&gt;SIMPLE VALIDATION FOR: EMPTY LOG FILE, INCORRECT LOG FORMAT - SO WE CAN SAFELY LOAD TO S3 - A STRUCTURALLY SOUND LOG FILE&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="10" y="290" width="130" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="" style="endArrow=classic;html=1;" edge="1" parent="1" target="2">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="-50" y="230" as="sourcePoint"/>
                        <mxPoint x="20" y="220" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="23" value="INGEST" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="20">
                    <mxGeometry x="-0.1251" y="1" relative="1" as="geometry">
                        <mxPoint x="9" y="1" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="21" value="" style="image;html=1;image=img/lib/clip_art/computers/Server_128x128.png" vertex="1" parent="1">
                    <mxGeometry x="-120" y="190" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SERVER&lt;/h1&gt;&lt;div&gt;SOURCE OF DATA&lt;/div&gt;&lt;div&gt;THIS PIPELINE INGESTS SERVER LOGS FROM A SERVER.&lt;/div&gt;&lt;div&gt;POTENTIAL ISSUES:&lt;/div&gt;&lt;div&gt;NETWORK ISSUES&lt;/div&gt;&lt;div&gt;- INGESTING LOGS FROM A SERVER THROUGH A NETWORK&lt;/div&gt;&lt;div&gt;- SERVER MAY BE DOWN&lt;/div&gt;&lt;div&gt;- SERVER MAY PRODUCE INCORRECT LOGS&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="-160" y="290" width="150" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;S3 BUCKET&lt;/h1&gt;&lt;div&gt;WE LOAD RAW LOG FILE TO S3 - WE CREATE AN S3 BUCKET TO HOLD ALL LOG FILES PARTITIONED USING THE HIVE PARTITIONING FORMAT - STORE LOG FILES BY DAY (SCALE TO HOURLY STORAGE FOR LARGE AMOUNTS OF INCOMING LOGS PER HOUR)&lt;/div&gt;&lt;div&gt;- OUTCOME - AN S3 BUCKET WITH RAW LOG DATA PARTITIONED USING HIVE&lt;/div&gt;&lt;div&gt;WE INCLUDE S3 IN THIS PIPELINE BECAUSE WE NEED TO STORE RAW LOG FILES FOR PERSISTENCE AND HISTORICAL AUDITING&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="151" y="290" width="150" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;PARSER&lt;/h1&gt;&lt;div&gt;THIS IS WHERE THE MAGIC, ERRORS AND BUGS ALL LIVE - WE SEEK TO FLESH OUT A STRUCTURE OUT OF THE UNSTRUCTRED LOGS.&amp;nbsp;&lt;/div&gt;&lt;div&gt;- WE USE REGEX AND FILE MATCHING PATTERNS TO FLESH OUT INDIVIDUAL EVENTS&lt;/div&gt;&lt;div&gt;- LOGS THAT DO NOT FOLLOW REQUIRED STRUCTURED ARE ACTUALLY LOGGED AND SAVED. WE DON&#39;T DISCARD THEM BUT USE THE DEAD LETTER QUEUE APPROACH TO HANDLE THEM&lt;/div&gt;&lt;div&gt;- OUTCOME - A STRUCTURED DATASET WITH CLEARLY DEFINED ROWS AND COLUMNS&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="341" y="290" width="169" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;AGGREGATION&lt;/h1&gt;&lt;div&gt;WE APPLY AGGREGATIONS LIKE SUM, COUNT, AVERAGES TO OUR STRUCTURED DATASET.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="550" y="290" width="190" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;DB - FINAL&lt;/h1&gt;&lt;div&gt;WE FINALLY LOAD THESE AGGREGATIONS&lt;/div&gt;&lt;div&gt;ALL SUCCESSFUL AGGREGATIONS ARE STORED&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;- REJECTED LOGS ARE ALSO SAVED AS A TABLE IN DATABASE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;OUR METRICS TABLE CONTAINS: TIME WINDOWS, ENDPOINT, STATUS CODE CATEGORY, USER DEFINED AGGREGATIONS&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="760" y="290" width="160" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="" style="edgeStyle=none;html=1;" edge="1" parent="1" source="29" target="5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="THE DATA ENGINEER STARTS HERE" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="77" y="130" width="230" height="30" as="geometry"/>
                </mxCell>
            </root>
